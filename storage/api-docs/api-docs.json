{
    "openapi": "3.0.0",
    "info": {
        "title": "Tupay Ledger & Settlement Engine",
        "description": "Production-grade cross-border financial backend (NGN ↔ CNY)",
        "version": "1.0.0"
    },
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Login with email and password",
                "operationId": "e49086969953bd8ab54daa2efbce4203",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "user@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "token": {
                                            "type": "string"
                                        },
                                        "user": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "email": {
                                                    "type": "string"
                                                },
                                                "first_name": {
                                                    "type": "string"
                                                },
                                                "last_name": {
                                                    "type": "string"
                                                },
                                                "middle_name": {
                                                    "type": "string",
                                                    "nullable": true
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "wallets": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer"
                                                    },
                                                    "currency": {
                                                        "type": "string",
                                                        "example": "NGN"
                                                    },
                                                    "balance": {
                                                        "type": "integer",
                                                        "example": 500000000
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            }
        },
        "/api/2fa/challenge": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Issue Elevated Action Token (EAT) after TOTP verification",
                "operationId": "bdc9c31d05d09414f787765d6bcf5650",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "totp_code",
                                    "action_payload"
                                ],
                                "properties": {
                                    "totp_code": {
                                        "description": "6-digit TOTP code from authenticator app",
                                        "type": "string",
                                        "example": "123456"
                                    },
                                    "action_payload": {
                                        "description": "Action parameters (must match exactly for swap)",
                                        "properties": {
                                            "source_currency": {
                                                "type": "string",
                                                "example": "NGN"
                                            },
                                            "destination_currency": {
                                                "type": "string",
                                                "example": "CNY"
                                            },
                                            "amount": {
                                                "type": "integer",
                                                "example": 1000000
                                            }
                                        },
                                        "type": "object"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "EAT issued successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "eat_token": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid TOTP"
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            }
        },
        "/api/debug/totp": {
            "get": {
                "tags": [
                    "Debug"
                ],
                "summary": "Get current TOTP code for testing",
                "description": "DEVELOPMENT ONLY - Returns the current 6-digit TOTP code for the authenticated user. Only available when APP_DEBUG=true.",
                "operationId": "0845dea6899080365e19e870f2b6cee3",
                "responses": {
                    "200": {
                        "description": "Current TOTP code",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "totp_code": {
                                            "type": "string",
                                            "example": "123456"
                                        },
                                        "user_id": {
                                            "type": "integer"
                                        },
                                        "email": {
                                            "type": "string"
                                        },
                                        "valid_for_seconds": {
                                            "type": "integer",
                                            "example": 30
                                        },
                                        "warning": {
                                            "type": "string",
                                            "example": "DEBUG ENDPOINT - Only available in development mode"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Debug mode disabled (APP_DEBUG=false)"
                    },
                    "400": {
                        "description": "TOTP not configured for user"
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            }
        },
        "/api/ledger/{wallet}": {
            "get": {
                "tags": [
                    "Ledger"
                ],
                "summary": "Get wallet ledger entries",
                "operationId": "280926b3f511be4d3bcca43aeebc2a3d",
                "parameters": [
                    {
                        "name": "wallet",
                        "in": "path",
                        "description": "Wallet ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Entries per page",
                        "schema": {
                            "type": "integer",
                            "default": 50
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Ledger entries retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "wallet_id": {
                                            "type": "integer"
                                        },
                                        "currency": {
                                            "type": "string",
                                            "example": "NGN"
                                        },
                                        "balance": {
                                            "type": "integer"
                                        },
                                        "entries": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer"
                                                    },
                                                    "type": {
                                                        "type": "string",
                                                        "enum": [
                                                            "debit",
                                                            "credit"
                                                        ]
                                                    },
                                                    "amount": {
                                                        "type": "integer"
                                                    },
                                                    "reference_id": {
                                                        "type": "string"
                                                    },
                                                    "created_at": {
                                                        "type": "string",
                                                        "format": "date-time"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        },
                                        "pagination": {
                                            "properties": {
                                                "total": {
                                                    "type": "integer"
                                                },
                                                "per_page": {
                                                    "type": "integer"
                                                },
                                                "current_page": {
                                                    "type": "integer"
                                                },
                                                "last_page": {
                                                    "type": "integer"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Unauthorized wallet access"
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            }
        },
        "/api/debug/settlement-signature": {
            "get": {
                "tags": [
                    "Settlement Debug"
                ],
                "summary": "Generate settlement webhook signature",
                "description": "DEVELOPMENT ONLY - Generates a valid HMAC-SHA256 signature for testing the settlement webhook. Only available when APP_DEBUG=true.",
                "operationId": "b899cf4c7c808e8bd3aed248edb472a1",
                "parameters": [
                    {
                        "name": "transaction_id",
                        "in": "query",
                        "description": "Transaction ID to settle",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "description": "Settlement status",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "completed",
                                "failed"
                            ],
                            "example": "completed"
                        }
                    },
                    {
                        "name": "settled_at",
                        "in": "query",
                        "description": "Settlement timestamp (ISO 8601)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Generated signature and payload",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "transaction_id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "completed"
                                        },
                                        "settled_at": {
                                            "type": "string",
                                            "example": "2026-08-05T13:00:00Z"
                                        },
                                        "signature": {
                                            "type": "string",
                                            "example": "abc123..."
                                        },
                                        "curl_example": {
                                            "description": "Ready-to-use curl command",
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Debug mode disabled (APP_DEBUG=false)"
                    },
                    "404": {
                        "description": "Transaction not found"
                    }
                }
            }
        },
        "/api/webhook/settlement": {
            "post": {
                "tags": [
                    "Settlement"
                ],
                "summary": "Process settlement webhook",
                "operationId": "d1dc5ab7c30ecbe4cff4d6c083f2706f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "transaction_id",
                                    "status",
                                    "settled_at",
                                    "signature"
                                ],
                                "properties": {
                                    "transaction_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "status": {
                                        "type": "string",
                                        "enum": [
                                            "completed",
                                            "failed"
                                        ]
                                    },
                                    "settled_at": {
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2026-08-05T12:00:00Z"
                                    },
                                    "signature": {
                                        "description": "HMAC-SHA256 signature",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Settlement processed successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid signature"
                    },
                    "404": {
                        "description": "Transaction not found"
                    }
                }
            }
        },
        "/api/swap": {
            "post": {
                "tags": [
                    "Swap"
                ],
                "summary": "Execute currency swap",
                "operationId": "0353ea658c36c9dc29c506c21c4bfcd8",
                "parameters": [
                    {
                        "name": "X-Elevated-Action-Token",
                        "in": "header",
                        "description": "EAT token from 2FA challenge",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "source_currency",
                                    "destination_currency",
                                    "amount"
                                ],
                                "properties": {
                                    "source_currency": {
                                        "type": "string",
                                        "example": "NGN"
                                    },
                                    "destination_currency": {
                                        "type": "string",
                                        "example": "CNY"
                                    },
                                    "amount": {
                                        "type": "integer",
                                        "example": 1000000
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Swap executed successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "transaction_id": {
                                            "type": "integer"
                                        },
                                        "status": {
                                            "type": "string"
                                        },
                                        "source_amount": {
                                            "type": "integer"
                                        },
                                        "destination_amount": {
                                            "type": "integer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid or expired EAT token"
                    },
                    "409": {
                        "description": "Insufficient balance"
                    },
                    "422": {
                        "description": "Invalid request parameters"
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            }
        },
        "/api/user": {
            "get": {
                "tags": [
                    "User"
                ],
                "summary": "Get the authenticated user",
                "operationId": "30e87a2b41cda034f2df75e6c356007a",
                "responses": {
                    "200": {
                        "description": "The authenticated user"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "Bearer": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "Bearer": {
                "type": "http",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Authentication endpoints"
        },
        {
            "name": "Debug",
            "description": "Debug endpoints (development only, requires APP_DEBUG=true)"
        },
        {
            "name": "Ledger",
            "description": "Ledger history endpoints"
        },
        {
            "name": "Settlement Debug",
            "description": "Settlement webhook debug endpoints (development only, requires APP_DEBUG=true)"
        },
        {
            "name": "Settlement",
            "description": "Settlement webhook endpoints"
        },
        {
            "name": "Swap",
            "description": "Currency swap endpoints"
        },
        {
            "name": "User",
            "description": "User"
        }
    ]
}